@if (Tags.Count > 0)
{
    <ul class="tags" aria-label="@Label">
        @foreach (var tag in Tags)
        {
            <li>@tag</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Tags { get; set; } = [];
    [Parameter] public string Label { get; set; } = "Technologies";
}
